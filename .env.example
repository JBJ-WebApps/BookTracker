VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Set to 'true' to show the client-portal Statements panel (dark feature, default off).
# VITE_STATEMENTS_ENABLED=false

# ---------------------------------------------------------------------------
# SERVER-SIDE ONLY — used by the Netlify function netlify/functions/manage-users.js
# (Add user / reset password / delete user). Set these in the Netlify dashboard
# under Site settings → Environment variables. DO NOT put the service-role key
# in any VITE_ variable or commit it — it bypasses all row-level security.
# ---------------------------------------------------------------------------
# SUPABASE_URL=https://your-project-ref.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ---------------------------------------------------------------------------
# SERVER-SIDE ONLY — CCH Axcess client-portal integration (publish-statement.js).
# Leave CCH_ENABLED unset/false to use the built-in MOCK provider. When CCH grants
# API access, fill these in (in Netlify env), implement cchProvider.publish(), and
# set CCH_ENABLED=true. Values below are placeholders to confirm with CCH.
# ---------------------------------------------------------------------------
# CCH_ENABLED=false
# CCH_OAUTH_URL=https://.../oauth2/token
# CCH_CLIENT_ID=
# CCH_CLIENT_SECRET=
# CCH_API_BASE=https://api.cchaxcess.../
# CCH_SCOPE=
