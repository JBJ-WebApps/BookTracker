VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Set to 'true' to show the client-portal Statements panel (dark feature, default off).
# VITE_STATEMENTS_ENABLED=false

# ---------------------------------------------------------------------------
# SERVER-SIDE ONLY — used by the Netlify function netlify/functions/manage-users.js
# (Add user / reset password / delete user). Set these in the Netlify dashboard
# under Site settings → Environment variables. DO NOT put the service-role key
# in any VITE_ variable or commit it — it bypasses all row-level security.
# ---------------------------------------------------------------------------
# SUPABASE_URL=https://your-project-ref.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ---------------------------------------------------------------------------
# SERVER-SIDE ONLY — SafeSend Exchange delivery (publish-statement.js).
# Leave SAFESEND_ENABLED unset/false to use the built-in MOCK provider (dry-run).
# To deliver for real: set SAFESEND_ENABLED=true and fill these in (Netlify env).
# Get Client ID / Secret / Audience from SafeSend → Developer Section → APIs Client.
# The firm's plan must include SafeSend Exchange.
# ---------------------------------------------------------------------------
# SAFESEND_ENABLED=false
# SAFESEND_CLIENT_ID=
# SAFESEND_CLIENT_SECRET=
# SAFESEND_AUDIENCE=
# SAFESEND_USER_EMAIL=authorized-user@jbjcpas.com   # sent as the required x-email header
# SAFESEND_TOKEN_URL=https://auth.thomsonreuters.com/oauth/token   # optional (default)
# SAFESEND_API_BASE=https://api.safesend.com                       # optional (default)
# SAFESEND_SUBSCRIPTION_KEY=                                        # optional
# SAFESEND_RETENTION_PERIOD=OneYear                                # optional
